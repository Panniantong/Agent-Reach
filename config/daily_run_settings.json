    },
    "sector_pools": {
      "半导体": [
        {"code": "688008", "name": "澜起科技", "keywords": ["澜起", "DDR", "内存", "半导体"]},
        {"code": "688981", "name": "中芯国际", "keywords": ["中芯", "晶圆", "半导体"]},
        {"code": "688012", "name": "中微公司", "keywords": ["中微", "设备", "半导体"]},
        {"code": "600584", "name": "长电科技", "keywords": ["长电", "封测", "半导体"]}
      ],
      "存储": [
        {"code": "603986", "name": "兆易创新", "keywords": ["兆易", "存储", "NOR", "MCU"]},
