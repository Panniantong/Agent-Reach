  },

  "close_improvements": {
    "enabled": true
  },

  "close_code_review": {
    "enabled": true,
    "auto_fix_portfolio": true,
    "walk_on_close": false,
    "run_smoke_tests": false,
    "walk_modules": [
      "portfolio_manager.py",
      "watchlist_manager.py",
      "intraday.py",
      "schedule.py",
      "workflows.py",
      "close_improvements.py",
      "close_code_review.py"
    ]
  },

  "trade_calendar": {
    "enabled": true,
    "skip_on_holiday": true
  },

  "experience": {
    "enabled": true,
    "max_rules": 50,
    "max_entries": 200
  }
}
