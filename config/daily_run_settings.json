{
  "version": "1.0.0",
  "description": "股票大师 daily_run_skill 外置配置",

  "mss_weights": {
    "fx": 0.2,
    "flow": 0.2,
    "global": 0.15,
    "sentiment": 0.15,
    "technical": 0.15,
    "quant": 0.1,
    "risk": 0.05
  },

  "morning_mss": {
    "use_prior_close": true,
    "show_delta_in_report": true
  },

  "thresholds": {
    "max_snapshot_age_hours": 24,
    "low_position_20d": 0.4
  },

  "buffett_filter": {
    "min_gross_margin": 0.35,
    "max_peg": 1.2,
    "min_roe": 0.15
  },

  "trading": {
    "commission_rate": 0.0015,
    "slippage_rate": 0.001
  },

  "quality_gate": {
    "required_fields": [
      "verdict",
      "confidence",
      "mss_final",
      "reasoning",
      "invalidation",
      "evidence_chain"
    ],
    "block_push_on_fail": true,
    "allow_downgrade_on_missing_technical": true
  },

  "data_audit": {
    "required_source_categories": ["quote", "flow", "sentiment"],
    "block_on_audit_fail": true,
    "block_on_price_deviation": true,
    "close_block_on_audit_fail": true,
    "intraday_block_on_audit_fail": false,
    "min_quote_coverage_pct": 0.8,
    "quote_coverage_mode": "block",
    "required_doctor_channels": ["web", "xueqiu"],
    "harness_evolve": true
  },

  "pnl_overview": {
    "harness_evolve": true,
    "large_unrealized_loss_cny": 5000,
    "large_realized_loss_cny": 500,
    "large_unrealized_loss_pct": 10
  },

  "pnl_target": {
    "enabled": true,
    "harness_evolve": true,
    "base_target_pct": 0.5,
    "base_target_cny": 0,
    "min_target_cny": 100,
    "streak_bonus_pct": 10,
    "miss_recovery_factor": 0.8,
    "evaluate_by_pct": false,
    "history_limit": 120,
    "reward_plan": "pnl_target：目标达成，维持策略并适度进攻",
    "penalty_plan": "pnl_target：目标未达，下日 verify 偏防御"
  },

  "quote_fetch": {
    "sources": ["eastmoney", "akshare", "xueqiu"],
    "max_retries": 2
  },

  "feishu": {
    "send_max_retries": 3,
    "send_backoff_seconds": [1, 2, 4],
    "fallback_plaintext_on_card_error": true
  },

  "verdict_labels": {
    "buy": "可做",
    "watch": "观察",
    "avoid": "回避"
  },

  "confidence_levels": ["高", "中", "低"],

  "report": {
    "split_push": true,
    "split_push_interval_seconds": 0.3,
    "morning_split_push": true,
    "close_split_push": true,
    "feishu_split_tables": true,
    "feishu_template_premarket": "orange",
    "feishu_template_intraday": "blue",
    "feishu_template_close": "purple",
    "feishu_template_verify": "purple",
    "feishu_template_weekly": "blue",
    "feishu_template_forecast": "blue",
    "weekly_split_push": true,
    "forecast_split_push": true
  },

  "weekly_report": {
    "enabled": true,
    "split_push": true,
    "exa_sector_research": true,
    "max_sector_queries": 3,
    "skill_learning": true,
    "skill_writeback": true,
    "skill_auto_apply_settings": true,
    "skill_sync_local": true,
    "skill_sync_runtime": true,
    "skill_audit": true,
    "skill_archive": true,
    "skill_archive_keep_weeks": 2,
    "skill_archive_llm_summary": true,
    "exa_skill_research": true,
    "max_skill_queries": 2,
    "max_skill_items": 8,
    "process_improvements": true,
    "max_improvement_items": 12,
    "skill_gates": {
      "enabled": true,
      "harness_evolve": true,
      "max_lines": 400,
      "block_weekly_push": true,
      "require_sections": true,
      "require_playbook": true,
      "require_experience": true,
      "snapshot_blocks": true,
      "max_playbook_lines": 45,
      "max_experience_lines": 55,
      "verify_fingerprints": true
    },
    "skill_external": {
      "enabled": true
    }
  },

  "week_forecast": {
    "enabled": true,
    "harness_evolve": true,
    "split_push": true,
    "exa_news_research": true,
    "max_news_queries": 2,
    "close_review": true,
    "reuse_weekly_digest_exa": true,
    "calibration_learning_rate": 0.15,
    "max_bias_pct": 3.0,
    "min_vol_scale": 0.6,
    "max_vol_scale": 1.6,
    "llm_narrative": {
      "enabled": true,
      "provider": "deepseek",
      "model": "deepseek-v4-flash",
      "timeout_seconds": 60
    }
  },

  "kronos": {
    "enabled": false,
    "repo_path": "~/.agent-reach/vendor/FaceCat-Kronos",
    "tokenizer_model": "NeoQuasar/Kronos-Tokenizer-base",
    "predictor_model": "NeoQuasar/Kronos-small",
    "lookback_window": 90,
    "predict_window": 10,
    "max_context": 512,
    "clip": 5.0,
    "inference_T": 0.6,
    "inference_top_p": 0.9,
    "inference_top_k": 0,
    "inference_sample_count": 5,
    "week_forecast_blend_weight": 0.35,
    "technical_max_score_delta": 12,
    "attach_to_snapshot": true,
    "attach_predict_days": 5,
    "local_files_only": false,
    "verbose": false,
    "log_errors": true
  },

  "findskills": {
    "enabled": true,
    "result_limit": 3,
    "timeout": 45,
    "max_queries": 2
  },

  "akshare": {
    "enabled": true,
    "default_history_days": 60,
    "adjust": "qfq",
    "lookback_days": 20
  },

  "backtest": {
    "default_initial_capital": 100000,
    "commission_rate": 0.0015,
    "macro_veto": 40,
    "aggressive_entry": 50
  },

  "optimizer": {
    "harness_evolve": true,
    "macro_veto_grid": [38, 40, 42, 45],
    "aggressive_entry_grid": [48, 50, 52, 55],
    "default_objective": "excess_return",
    "mss_weight_grid": [
      {"fx": 0.3, "flow": 0.3, "global": 0.2, "sentiment": 0.2},
      {"fx": 0.25, "flow": 0.35, "global": 0.2, "sentiment": 0.2},
      {"fx": 0.35, "flow": 0.25, "global": 0.2, "sentiment": 0.2},
      {"fx": 0.2, "flow": 0.3, "global": 0.3, "sentiment": 0.2}
    ]
  },

  "plugins": {
    "enabled": [
      "fundamental",
      "technical",
      "quant",
      "risk",
      "macro",
      "industry",
      "sentiment",
      "identifier"
    ],
    "parallel": true,
    "channel_enrich": true,
    "exa_research_on_close": true,
    "max_exa_queries": 3,
    "exa_timeout": 45,
    "max_exa_queries_per_expert": 1
  },

  "team": {
    "enabled": false,
    "mss_experts": true,
    "morning_mss_experts": true,
    "intraday_mss_experts": true,
    "close_mss_experts": true,
    "mode": "full_parallel",
    "experts": [
      "fundamental",
      "technical",
      "quant",
      "risk",
      "macro",
      "industry",
      "sentiment",
      "identifier"
    ],
    "parallel": true,
    "supervisor": true,
    "morning_team_first": false,
    "close_team_first": false,
    "intraday_experts": false
  },

  "macro_collector": {
    "enabled": true,
    "sentiment_post_limit": 5
  },

  "hot_news": {
    "enabled": true,
    "platforms": ["60s", "weibo", "zhihu", "it-news"],
    "base_urls": ["http://127.0.0.1:8787", "https://60s.viki.moe"],
    "cache_ttl_seconds": 600,
    "timeout_seconds": 12,
    "limit_per_platform": 20,
    "match_portfolio_keywords": true,
    "extra_keywords": ["存储", "芯片", "DDR", "北向", "半导体", "AI", "光通信"],
    "sentiment_boost_per_hit": 2,
    "deploy": {
      "mode": "native",
      "host_port": 8787,
      "repo_url": "https://github.com/vikiboss/60s.git"
    }
  },

  "mss_forecast": {
    "simulations": 200
  },

  "schedule": {
    "executor": "local_cron",
    "symbols_mode": "all",
    "intraday_symbols_mode": "all",
    "intraday_gc_between_symbols": true,
    "symbol_push_mode": "merge_by_category",
    "symbol_push_interval_seconds": 0.5,
    "intraday_trade_enabled": true,
    "morning_doctor": true,
    "alert_after_consecutive_failures": 3,
    "intraday_push_mode": "smart",
    "intraday_push_milestones": ["S1", "S2", "S3", "S15"],
    "doctor_cache": true,
    "doctor_cache_ttl_seconds": 14400,
    "guard": {
      "enabled": true,
      "dedupe_jobs": true,
      "harness_evolve": true
    }
  },

  "snapshot": {
    "intraday_enrich_level": "quotes"
  },

  "market_review": {
    "enabled": true,
    "persist": true,
    "fetch_timeout_seconds": 15
  },

