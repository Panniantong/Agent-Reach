      ],
      "光通信": [
        {"code": "300308", "name": "中际旭创", "keywords": ["中际", "光模块", "CPO"]},
        {"code": "002273", "name": "水晶光电", "keywords": ["水晶", "光学", "光通信"]}
      ],
      "面板": [
